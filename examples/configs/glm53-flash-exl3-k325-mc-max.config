# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K3.25 MC, original BF16 core, max (2x RTX, 0 Sparks).
#
# Replaces the plain K3.25-Core-FP8 max card in the v6 set (#2473); use a
# matching WIP build. Every expert runs on the two RTX GPUs. Download the
# checkpoint (and drafter) first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k325-mc-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k325-mc-max.config --restart
#
# The original BF16 core is the default; optional views: k8-compact, k6-compact
# and runtime-derived fp8-compact (quantizes the original selected core).

MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K3.25-MC
MODEL_REVISION=83da6981e57e110fd1ba166e0a989c411e4289b6
CORE_VIEW=original
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
