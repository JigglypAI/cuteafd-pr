# Hy4-flash EXL3 K4 MC, K8 compact core, min (1x RTX PRO 6000, 0 Sparks).
#
# WIP qualification config (#2478); launch with a matching WIP slot (--wip SLOT).
# All 41 routed LatentMoE layers run locally on the RTX PRO 6000; Engram FP8 tables
# (61.5 GiB) remain host-resident via MappedPlacement.

MODEL_ID=wrldsuksgo2mars/Hy4-flash-EXL3-K4-MC
MODEL_REVISION=cc72179113573d751ed3245e3e58d3640694378d
CORE_VIEW=k8-compact
VISION=auto
AUDIO=off
POOL_TOKENS=auto
HOST_CACHE_BYTES=auto
EXPERT_BACKEND=local

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=0

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
