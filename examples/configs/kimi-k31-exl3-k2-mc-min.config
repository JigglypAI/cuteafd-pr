# Kimi K3.1 Pro MC K6 compact: 1 RTX + 6 Sparks, automatic pool/onboarding.
# Replace the example Spark hosts and rail-A addresses before launching.
# The K6 compact view is the accepted stored core (#2128); original BF16 does
# not fit one RTX. K8 and FP8 compact serving remain unqualified.
# Native Inferact block DSpark defaults on; explicit SPECULATOR=off disables it.
# ./run.sh --config examples/configs/kimi-k31-exl3-k2-mc-min.config --wip SLOT --restart
MODEL_ID=wrldsuksgo2mars/Kimi-K3.1-Pro-EXL3-K2-MC
MODEL_REVISION=1455b31b0acc53f36df916864fb541d9f536b3f8
CORE_VIEW=k6-compact
SPECULATOR=auto
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=off
RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=6
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# Current promoted image pair; use a qualified WIP slot until the next release.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
