# Inkling 2 Small EXL3 K4 MC original core: 1 RTX + 4 Sparks.
# Standard fidelity and Release smoke qualified; requires matching exports.
# Replace the placeholder hosts and documentation addresses before launching.

MODEL_ID=wrldsuksgo2mars/Inkling-2-Small-EXL3-K4-MC
MODEL_REVISION=6caa0ba08eb564ddc88b98df06ac73e853cc559e
CORE_VIEW=original
SPECULATOR=dspark
VISION=off
AUDIO=off
POOL_TOKENS=auto
HOST_CACHE_BYTES=auto
EXPERT_BACKEND=spark

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=4
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# Promoted images are listed for consistency; qualify with a matching WIP slot.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
